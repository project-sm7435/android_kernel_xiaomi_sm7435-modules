DISPLAY_SRC := $(if $(filter /%,$(src)),$(src),$(srctree)/$(src))
ifeq ($(DISPLAY_ROOT),)
DISPLAY_ROOT := $(DISPLAY_SRC)
endif
DISPLAY_ROOT := $(if $(filter /%,$(DISPLAY_ROOT)),$(DISPLAY_ROOT),$(srctree)/$(DISPLAY_ROOT))

LINUXINCLUDE    += \
		   -I$(DISPLAY_ROOT)/include/uapi/display \
		   -I$(DISPLAY_ROOT)/include
USERINCLUDE     += -I$(DISPLAY_ROOT)/include/uapi/display

obj-$(CONFIG_DRM_MSM) += msm/
